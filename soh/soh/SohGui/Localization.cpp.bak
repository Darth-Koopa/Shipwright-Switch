    { "Prevent Bombchus Forcing First-Person", "防止炸弹鼠强制第一人称" },
    { "Prevent Bombchus from forcing the camera into first-person mode when released.", "防止炸弹鼠在释放时强制相机进入第一人称模式。" },
    { "Prevent Dropped Ocarina Inputs", "防止丢弃的陶笛输入" },
    { "Prevent dropping inputs when playing the Ocarina too quickly.", "防止演奏陶笛过快时丢弃输入。" },
    { "Prevent forced conversations with Navi and/or other NPCs.", "防止与娜薇和/或其他 NPC 的强制对话。" },
    { "Prevent notifications from playing a sound.", "防止通知播放声音。" },
    { "Prevent the Gerudo Warrior's clothes changing color when changing Link's tunic or ", "防止格鲁德战士的衣服在更换林克外衣或" },
    { "Prevents ReDeads and Gibdos from being able to freeze you with their scream.", "防止 ReDead 和吉布多用尖叫冻结你。" },
    { "Prevents bugs from automatically despawning after a while when dropped.", "防止虫子掉落一段时间后自动消失。" },
    { "Prevents fish from automatically despawning after a while when dropped.", "防止鱼掉落一段时间后自动消失。" },
    { "Prevents immediately falling off climbable surfaces if climbing on the edges.", "防止在边缘攀爬时立即从可攀爬表面掉落。" },
    { "Prevents integer scaling factor from exceeding screen bounds.\n\n", "防止整数缩放因子超出屏幕边界。\n\n" },
    { "Prevents the Deku Shield from burning on contact with fire.", "防止代库盾接触火时燃烧。" },
    { "Prevents the Forest Stage Deku Nut upgrade from becoming unobtainable ", "防止森林舞台代库坚果升级变得无法获得" },
    { "Prevents the Poacher's Saw softlock from mashing through the text, or with Skip Text enabled.", "防止偷猎者锯子软锁通过连按文本或启用跳过文本触发。" },
    { "Prevents the big Cucco from appearing in the Bombchu Bowling minigame.", "防止大公鸡出现在炸弹鼠保龄球小游戏。" },
